SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for `npm run db:migrate` (Dashboard -> Connect -> connection string).
DATABASE_URL=
PORT=4000
CORS_ORIGIN=*
NODE_ENV=development

# Transactional email (Resend). When RESEND_API_KEY is set, signup
# confirmation emails are sent through Resend and the account is created
# unconfirmed. Without it, Supabase's built-in mailer is used instead.
RESEND_API_KEY=
MAIL_FROM=NoticeRadar <onboarding@resend.dev>
# Optional reply-to address shown to recipients.
MAIL_REPLY_TO=
# Public frontend URL used for links inside emails.
APP_URL=https://notice-radar-six.vercel.app


LLM_PROVIDER=gemini
LLM_API_KEY=paste_your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash


ENABLE_SCHEDULER=false
