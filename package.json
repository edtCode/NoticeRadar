{
  "name": "noticeradar-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NoticeRadar backend API built with Express and Supabase",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test src/tests",
    "db:check": "node scripts/check-supabase.js",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "test:live": "node scripts/live-e2e.mjs",
    "test:smoke": "node scripts/smoke-all.mjs",
    "verify:register": "node scripts/verify-register.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "supertest": "^7.0.0"
  }
}
