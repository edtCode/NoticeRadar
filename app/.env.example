# NoticeRadar frontend — environment

# Express API base (all routes are prefixed /api/v1)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Public Supabase project values only. NEVER place the service-role key
# or the LLM API key in a VITE_ variable — they ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
